# ---- PlatformIO 构建产物（每个工程约 37 MB，共约 290 MB）----
.pio/
.pioenvs/
.piolibdeps/
.pio/libdeps/

# ---- VS Code / 编辑器个人配置 ----
.vscode/
.idea/
*.code-workspace

# ---- AI 辅助工具的会话日志 ----
.deep-copilot/

# ---- Office 临时文件（打开 docx 时会生成 ~$ 开头的锁文件）----
~$*

# ---- 操作系统与编辑器临时文件 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*~
